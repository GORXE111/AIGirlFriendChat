# 复制为 .env 后填写。.env 不要提交。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── 可选覆盖 ──

# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_TIMEOUT_SECONDS=100        # 选项制每回合要生成 JSON，比单句慢
# LLM_MAX_RETRIES=3
# LLM_MAX_CONCURRENCY=32
# LOG_LEVEL=INFO

# DB_PATH=data/saves.db

# 她所在的时区。她是中国高中生，日程按她的当地时间走，跟开发者在哪无关。
# 与 DeepSeek 峰谷计费时区（恒为北京）是两回事。
# STORY_TIMEZONE=Asia/Shanghai

# 回复延迟。日程已按聊天体验校准（秒到几分钟），通常不需要压缩。
# DELAY_SCALE=1.0

# 单次回复的延迟上限（秒）。⚠️ 仓库里当前是 5，那是测试值 ——
# 等于关掉了延迟机制，所有时段都秒回。正式跑改回 600。
# MAX_DELAY_SECONDS=600

# 对话累积到阈值后自动跑慢回路归档
# AUTO_REFLECT=true
